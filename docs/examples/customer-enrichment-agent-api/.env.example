# Copy this file to .env. Never commit the populated .env file.
PERPLEXITY_API_KEY=
MODEL=perplexity/glm-5.3

# Required acknowledgement for commands that spend Agent API credits.
CONFIRM_LIVE_SPEND=NO

# Local-only ClickHouse instance exposed on loopback. The tutorial uses separate
# setup and least-privilege users without committed passwords.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=customer_enrichment
CLICKHOUSE_SETUP_USER=default
CLICKHOUSE_APP_USER=customer_enrichment_app
